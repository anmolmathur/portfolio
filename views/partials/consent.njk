<div class="consent" id="consent" hidden role="dialog" aria-live="polite"
     aria-label="{{ copy.ui.consent.title }}">
  <div class="consent-body">
    <p class="consent-title">{{ copy.ui.consent.title }}</p>
    <p class="consent-text">{{ copy.ui.consent.body }}</p>
  </div>
  <div class="consent-actions">
    <button type="button" class="btn-ghost" data-consent="decline">{{ copy.ui.consent.decline }}</button>
    <button type="button" class="btn" data-consent="accept">{{ copy.ui.consent.accept }}</button>
  </div>
</div>
