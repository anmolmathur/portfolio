{#
  Guide — the single include. This partial plus public/js/guide/ IS the whole
  feature; deleting both removes it completely.

  Copy is handed over from content/<locale>.json rather than hard-coded in the
  JS, so adding Spanish stays a content-only change like everything else on
  this site.

  `| dump` emits valid JSON. autoescape is on globally, and `| safe` here is
  deliberate and safe: the value is JSON-serialised by Nunjucks, not raw
  author HTML. The </script> guard below covers the one case JSON escaping
  does not — a copy string containing that literal would otherwise close this
  block early.
#}
<script>
  window.__guideConfig = {
    endpoint: "/api/guide/ask",
    locale: {{ locale | dump | safe }},
    copy: {{ copy.ui.guide | dump | replace("</script", "<\\/script") | safe }}
  };
</script>
{#
  Import map for the avatar stage. MUST come before any <script type="module">
  on the page — the browser ignores an import map that arrives after the first
  module script, silently, and the stage then fails to resolve "three".

  The trailing slash on the "three/addons/" key is load-bearing and belongs
  OUTSIDE any path helper: without it the prefix mapping does not apply and
  every addon import 404s.

  Nothing here downloads three.js. The map is declarative; the 800KB is fetched
  only when panel.js dynamically imports the stage, which happens on first open.
#}
<script type="importmap">
{
  "imports": {
    "three": "/vendor/three/three.module.js",
    "three/addons/": "/vendor/three/addons/"
  }
}
</script>
<script src="/js/guide/bundle.js?v={{ guideVersion }}" defer></script>
