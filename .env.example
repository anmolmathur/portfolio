# Copy to .env on the Hetzner box. NEVER commit the real file.
# Secrets belong here or in the systemd/compose environment — never in the repo,
# and never pasted into a chat transcript.

PORT=3000
NODE_ENV=production

# --- Open WebUI (the avatar's agent tier) --------------------------------
OPENWEBUI_URL=https://ai.anmolmathur.com
OPENWEBUI_MODEL=portfolio-website-helper
OPENWEBUI_API_KEY=
# Optional: knowledge collection id for RAG over the site's own content
OPENWEBUI_KNOWLEDGE_ID=

# --- PostHog (self-hosted, proxied first-party at /ingest) ---------------
POSTHOG_HOST=https://posthog.anmolmathur.com
POSTHOG_PROJECT_KEY=
POSTHOG_PROXY_PATH=/ingest

# --- Google Analytics ----------------------------------------------------
GA_MEASUREMENT_ID=G-12VK07Q8CB

# --- Text to speech ------------------------------------------------------
# NOTE: OpenAI TTS cannot clone a voice. See VOICE.md.
TTS_PROVIDER=none
OPENAI_API_KEY=
TTS_CLONE_URL=
